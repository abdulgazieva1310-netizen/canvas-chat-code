# Default: SQLite file at backend/interview.db (absolute path resolved by the app).
# Override with a SQLAlchemy connection URL; backend/.env is loaded at startup.
DATABASE_URL=sqlite:///interview.db
SECURE_COOKIES=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://localhost:5173

# Groq Chat Completions API (https://console.groq.com). Optional: unset to use fixtures.
AI_API_KEY=your_api_key_here
AI_MODEL=openai/gpt-oss-120b
# Opt-in Russian preview; also requires a valid Groq key and the model above.
# A user's preferred language does not enable this server feature.
ENABLE_RUSSIAN_INTERVIEWS=false

# With SMTP_HOST set, send email; otherwise log reset links to the console for local testing.
EMAIL_ADAPTER=auto
# Set this to your public frontend reset page when deploying.
PASSWORD_RESET_URL=http://localhost:8080/reset-password
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=accounts@example.com
# SMTP_PASSWORD=replace-me
# SMTP_FROM=accounts@example.com  # Optional; defaults to SMTP_USER.
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
