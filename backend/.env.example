# Default: SQLite file at backend/interview.db (absolute path resolved by the app).
# Override with a SQLAlchemy connection URL; export it before starting the server.
DATABASE_URL=sqlite:///interview.db
SECURE_COOKIES=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://localhost:5173
